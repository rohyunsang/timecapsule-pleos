<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Read-only Pleos vehicle permissions for the mood tags and safety pause (spec 07: no CONTROL_CAR_*). -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />  <!-- Window, Wiper -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- Light, TurnSignal -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />  <!-- outside temperature -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />    <!-- DrivingMode, Brake, Odometer -->
    <uses-permission android:name="pleos.car.permission.CAR_TOLL" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pleos on-device TTS (narration) and STT (voice answer to the approach alert). -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Approach alert over navigation (Pleos hides heads-up notifications of regular apps). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Friends and shared capsules (Firebase). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Detect the Pleos services; otherwise the app falls back to fake car data. -->
    <queries>
        <package android:name="ai.pleos.service.car" />
        <package android:name="ai.pleos.playground.service.navi" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application
        android:name=".TimeCapsuleApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode">
            <!-- Screens 04-06 are usable while driving (spec 07). -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Friend QR code: timecapsule://friend?code=ABC234 adds that friend. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="timecapsule" android:host="friend" />
            </intent-filter>
        </activity>
        <receiver android:name=".drive.RecordingCommandReceiver" android:exported="true"
            android:permission="android.permission.MEDIA_CONTENT_CONTROL">
            <intent-filter>
                <action android:name="app.timecapsule.RECORD_START" />
                <action android:name="app.timecapsule.RECORD_SAVE" />
                <action android:name="app.timecapsule.RECORD_CANCEL" />
            </intent-filter>
        </receiver>
        <service android:name=".drive.DriveService" android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
        <receiver android:name=".drive.AlertActionReceiver" android:exported="false" />
    </application>
</manifest>
