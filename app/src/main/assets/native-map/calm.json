{
  "version": 8,
  "name": "TimeCapsule Calm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F5F4F0"
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#E8EEE5",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#DAE7EA"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#DAE7EA",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.5,
          16,
          3
        ]
      }
    },
    {
      "id": "major-road-edge",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#D6D7D3",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.5,
          12,
          2,
          16,
          8,
          19,
          20
        ]
      },
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary"
          ]
        ]
      ]
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.2,
          12,
          1.2,
          16,
          5,
          19,
          16
        ]
      },
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary"
          ]
        ]
      ]
    },
    {
      "id": "local-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0.5,
          16,
          2,
          19,
          8
        ]
      },
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "minor",
            "service"
          ]
        ]
      ],
      "minzoom": 13
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "paint": {
        "text-color": "#7D827F",
        "text-halo-color": "#F5F4F0",
        "text-halo-width": 1.5
      },
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary"
          ]
        ]
      ],
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 450,
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ko"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:latin"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-angle": 25
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "paint": {
        "text-color": "#6B746F",
        "text-halo-color": "#F5F4F0",
        "text-halo-width": 2
      },
      "maxzoom": 14,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "city",
            "town",
            "village",
            "suburb"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ko"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:latin"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "text-padding": 36
      }
    }
  ]
}
